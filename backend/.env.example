# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real secrets.

# Port the server listens on
PORT=3000

# Signs the session cookie. Set a long, random value in production.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite database file. Defaults to ./database.db if not set.
# Tests override this automatically to ':memory:'.
DB_FILE=database.db

# "development" | "production" | "test"
NODE_ENV=development

# ---- optional (sensible defaults shown) ----

# Comma-separated browser origins allowed to call the API cross-origin.
#   *                       -> any origin, but WITHOUT cookies
#   http://localhost:5173   -> that exact origin, WITH cookies
CORS_ORIGINS=*

# Per-request logging: "true" | "false" (default: on, except during tests)
LOG_REQUESTS=true

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Minutes a password-reset / email-verification token stays valid
TOKEN_TTL_MINUTES=60

# Days before its closing date that an opportunity is flagged "closing soon"
SOON_THRESHOLD_DAYS=30
